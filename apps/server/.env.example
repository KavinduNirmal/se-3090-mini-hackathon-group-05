# Server environment
# Copy to .env and fill in real values. .env is gitignored.

# --- NeonDB (Postgres) ---
# Pooled connection string used by the Prisma client at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER.region.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# --- App ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Clerk (added when auth module is implemented) ---
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# CLERK_WEBHOOK_SECRET=
