# Server environment (Express). Copy to .env for local development.
# .env files are gitignored. In production these are injected by the host
# (Azure App Service app settings / GitHub Actions secrets) — do NOT commit.

# Postgres (NeonDB) connection strings.
# DATABASE_URL  = pooled connection (used by the app via the pg driver adapter)
# DIRECT_URL    = direct/unpooled connection (used by Prisma Migrate)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/share-a-plate?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/share-a-plate?sslmode=require

# HTTP server. Azure App Service overrides PORT at runtime.
PORT=4000
NODE_ENV=development

# Optional: allowed browser origins for CORS (the Express bootstrap currently
# reflects the request origin; kept here for future tightening).
# CORS_ORIGIN=http://localhost:3000,https://share-a-plate.kavindunirmal.com

# Clerk keys (@clerk/express verifies JWTs for the admin API).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
