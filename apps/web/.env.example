# Web environment (Next.js loads this at dev/build time). Copy to .env.local.
# .env*.local files are gitignored.

# Base URL of the Express API used by the axios client.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk authentication keys (dashboard.clerk.com -> API Keys)
# Publishable key is safe for the browser; secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
